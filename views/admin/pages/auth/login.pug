extends ../../layouts/auth.pug
include ../../mixins/alert.pug 

block main 
    +alert-success()
    +alert-error()

    .auth-card 
        h1.auth-title Đăng nhập
        p.auth-subtitle Truy cập bảng điều khiển quản trị
        form(
            action=`${prefixAdmin}/auth/login`
            method="POST"
        )
            div(class="form-group")
                label(for="email") Email
                input(
                    type="email"
                    class="form-control"
                    id="email"
                    name="email"
                    required
                ) 
            div(class="form-group")
                label(for="password") Mật khẩu 
                input(
                    type="password"
                    class="form-control"
                    id="password"
                    name="password"
                    required 
                ) 
            button(class="btn btn-primary btn-block" type="submit") Đăng nhập 
