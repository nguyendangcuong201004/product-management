extends ../../layouts/default.pug

block main 
    .page-header 
        .page-header-info 
            h1.page-header-title Thông tin cá nhân
            p.page-header-desc Hồ sơ tài khoản quản trị của bạn

    .panel.profile-panel 
        .profile-head 
            img(
                class="profile-avatar"
                src=user.avatar ? user.avatar : "/admin/images/avatar.png"
                alt=user.fullName
            )
            div 
                h2.profile-name #{user.fullName}
                if (role.title)
                    span.tag.tag-brand #{role.title}

        dl.detail-list
            if (user.fullName)
                .profile-row 
                    dt Họ và tên
                    dd #{user.fullName}
            if (user.email)
                .profile-row 
                    dt Email
                    dd #{user.email}
            if (user.phone)
                .profile-row 
                    dt Số điện thoại
                    dd #{user.phone}
            if (user.status)
                .profile-row 
                    dt Trạng thái
                    dd
                        if (user.status == "active")
                            span.status.status-ok Hoạt động
                        else 
                            span.status.status-off Ngừng hoạt động
            if (user.role_id)
                .profile-row 
                    dt Phân quyền
                    dd #{role.title}
