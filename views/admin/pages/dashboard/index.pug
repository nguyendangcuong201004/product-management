extends ../../layouts/default.pug

block main 
    .page-header 
        .page-header-info 
            h1.page-header-title Tổng quan
            p.page-header-desc Tình hình hệ thống và thông tin tài khoản của bạn

    .panel.account-strip 
        img(
            class="account-strip-avatar"
            src=user.avatar ? user.avatar : "/admin/images/avatar.png"
            alt=user.fullName
        )
        .account-strip-info 
            p.account-strip-name #{user.fullName}
            if (role.title)
                span.tag.tag-brand #{role.title}
            if (user.email || user.phone)
                .account-strip-meta 
                    if (user.email)
                        span #{user.email}
                    if (user.phone)
                        span #{user.phone}

    .stat-grid 
        .stat-tile 
            p.stat-label Danh mục sản phẩm
            .stat-value #{statistic.categoryProduct.total}
            .stat-meta 
                span.status.status-ok #{statistic.categoryProduct.active} hoạt động
                span.status.status-off #{statistic.categoryProduct.inactive} ngừng

        .stat-tile 
            p.stat-label Sản phẩm
            .stat-value #{statistic.product.total}
            .stat-meta 
                span.status.status-ok #{statistic.product.active} hoạt động
                span.status.status-off #{statistic.product.inactive} ngừng

        .stat-tile 
            p.stat-label Tài khoản admin
            .stat-value #{statistic.account.total}
            .stat-meta 
                span.status.status-ok #{statistic.account.active} hoạt động
                span.status.status-off #{statistic.account.inactive} ngừng

        .stat-tile 
            p.stat-label Tài khoản client
            .stat-value #{statistic.user.total}
            .stat-meta 
                span.status.status-ok #{statistic.user.active} hoạt động
                span.status.status-off #{statistic.user.inactive} ngừng
