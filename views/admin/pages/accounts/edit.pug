extends ../../layouts/default.pug
include ../../mixins/alert.pug 

block main 
    .page-header 
        .page-header-info 
            h1.page-header-title Chỉnh sửa tài khoản
            p.page-header-desc #{data.fullName}
        .page-header-actions 
            a(href=`${prefixAdmin}/accounts` class="btn btn-ghost")
                i.fa-solid.fa-arrow-left
                | Danh sách

    +alert-success()
    +alert-error()

    form(
        action=`${prefixAdmin}/accounts/edit/${data.id}?_method=PATCH`
        method="POST"
        enctype="multipart/form-data"
    )
        .panel.form-panel 

            .form-section 
                p.form-section-title Thông tin tài khoản
                .form-grid.cols-2 
                    div 
                        label(for="fullName") Họ và tên
                        input(
                            class="form-control"
                            id="fullName"
                            name="fullName"
                            required
                            type="text"
                            value=data.fullName
                        ) 
                    div 
                        label(for="email") Email
                        input(
                            class="form-control"
                            id="email"
                            name="email"
                            required
                            type="email"
                            value=data.email
                        ) 
                    div 
                        label(for="password") Mật khẩu mới
                        input(
                            class="form-control"
                            id="password"
                            name="password"
                            type="password"
                            placeholder="Để trống nếu không đổi"
                        ) 
                    div 
                        label(for="phone") Số điện thoại
                        input(
                            class="form-control"
                            id="phone"
                            name="phone"
                            type="text"
                            value=data.phone
                        ) 

            .form-section 
                p.form-section-title Ảnh đại diện
                .form-grid 
                    div.upload-field(upload-image)
                        label(for="avatar") Chọn ảnh
                        input(
                            type="file"
                            class="form-control-file"
                            id="avatar"
                            name="avatar"
                            accept="image/*"
                            upload-image-input
                        ) 
                        img(
                            src=data.avatar
                            class="image-preview"
                            upload-image-preview
                            alt="Avatar preview"
                        )

            .form-section 
                p.form-section-title Phân quyền và trạng thái
                .form-grid.cols-2 
                    div 
                        label(for="role_id") Nhóm quyền  
                        select(
                            name="role_id"
                            id="role_id"
                            class="form-control"
                        ) 
                            option(disabled value) -- Chọn nhóm quyền -- 
                            each role in roles 
                                option(
                                    value=role.id
                                    selected = role.id == data.role_id ? true : false
                                ) #{role.title}
                    div 
                        label Trạng thái
                        .radio-group 
                            div(class="form-check form-check-inline")
                                input(
                                    type="radio"
                                    class="form-check-input"
                                    id="statusActive"
                                    name="status"
                                    value="active"
                                    checked = data.status == "active" ? true : false
                                )
                                label(for="statusActive" class="form-check-label") Hoạt động 
                            div(class="form-check form-check-inline")
                                input(
                                    type="radio"
                                    class="form-check-input"
                                    id="statusInActive"
                                    name="status"
                                    value="inactive"
                                    checked = data.status == "inactive" ? true : false
                                )
                                label(for="statusInActive" class="form-check-label") Ngừng hoạt động 

            .form-actions 
                button(
                    class="btn btn-primary"
                    type="submit"
                ) Cập nhật 
                a(href=`${prefixAdmin}/accounts` class="btn btn-ghost") Hủy
