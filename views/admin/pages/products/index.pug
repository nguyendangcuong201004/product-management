extends ../../layouts/default.pug
include ../../mixins/alert.pug
include ../../mixins/filter.pug
include ../../mixins/search.pug
include ../../mixins/pagination.pug


block main 

    if(role.permissions.includes("products_view"))

        +alert-success()
        +alert-error()

        .page-header 
            .page-header-info 
                h1.page-header-title Sản phẩm 
                p.page-header-desc Quản lý toàn bộ sản phẩm của cửa hàng
            .page-header-actions 
                if(role.permissions.includes("products_create"))
                    a(href=`${prefixAdmin}/products/create` class="btn btn-primary")
                        i.fa-solid.fa-plus
                        | Thêm mới 

        .toolbar 
            .toolbar-group 
                +filter(filterStatus)
            .toolbar-group 
                div(sort class="sort-box")
                    select(
                        class="form-control form-control-sm"
                        name="sort"
                        sort-select 
                        aria-label="Sắp xếp"
                    ) 
                        option(value="position-desc") Vị trí giảm dần 
                        option(value="position-asc") Vị trí tăng dần 
                        option(value="price-desc") Giá giảm dần 
                        option(value="price-asc") Giá tăng dần  
                        option(value="title-asc") Tiêu đề từ A - Z 
                        option(value="title-desc") Tiêu đề từ Z - A 
                    button(
                        type="button"
                        class="icon-btn icon-btn-sm"
                        sort-clear
                        title="Xóa sắp xếp"
                        aria-label="Xóa sắp xếp"
                    )
                        i.fa-solid.fa-xmark
                +search(keyword)

        .panel.table-panel 

            if (products.length > 0)

                .table-responsive 
                    table(
                        class="table"
                        checkbox-multi=""
                    )
                        thead 
                            tr 
                                th.checkbox-col
                                    input(type="checkbox" name="checkall" aria-label="Chọn tất cả")
                                th STT 
                                th Ảnh
                                th Sản phẩm
                                th.text-right Giá 
                                th Vị trí
                                th Trạng thái 
                                th Người tạo
                                th.text-right Hành động
                        tbody 
                            each item, index in products
                                tr
                                    td.checkbox-col
                                        input(type="checkbox" name="id" value=item.id aria-label=("Chọn " + item.title))
                                    td.cell-muted.tnum #{objectPagination.limitItems * (objectPagination.currentPage - 1) + index + 1}
                                    td
                                        img(
                                            class="table-thumb"
                                            src=item.thumbnail
                                            alt=item.title
                                            loading="lazy"
                                        )
                                    td 
                                        .cell-strong #{item.title}
                                    td.cell-num #{new Intl.NumberFormat("vi-VN").format(item.price)}₫
                                    td 
                                        input(
                                            value=item.position
                                            type="number"
                                            min="1"
                                            name="position"
                                            class="form-control input-position"
                                            aria-label="Vị trí"
                                        )
                                    td
                                        if (item.status == "active")
                                            a(href="javascript:;" class="status status-ok" button-change-status="" data-id=item.id data-status="inactive") Hoạt động
                                        else 
                                            a(href="javascript:;" class="status status-off" button-change-status="" data-id=item.id data-status="active") Ngừng hoạt động
                                    td 
                                        .cell-strong.cell-sm #{item.createdByFullName}
                                        .cell-muted.tnum #{moment(item.createdAt).format('DD/MM/YYYY')}
                                    td
                                        .row-actions
                                            if(role.permissions.includes("products_edit"))
                                                a(
                                                    class="icon-btn icon-btn-sm"
                                                    href=`${prefixAdmin}/products/edit/${item.id}`
                                                    title="Sửa"
                                                    aria-label="Sửa"
                                                )
                                                    i.fa-regular.fa-pen-to-square
                                            if(role.permissions.includes("products_delete"))
                                                button(
                                                    type="button"
                                                    class="icon-btn icon-btn-sm icon-danger"
                                                    button-delete=""
                                                    data-id=item.id
                                                    title="Xóa"
                                                    aria-label="Xóa"
                                                )
                                                    i.fa-regular.fa-trash-can
                                            a(
                                                class="icon-btn icon-btn-sm"
                                                href=`${prefixAdmin}/products/detail/${item.id}`
                                                title="Chi tiết"
                                                aria-label="Chi tiết"
                                            )
                                                i.fa-regular.fa-eye

                .bulk-bar(bulk-bar)
                    span.bulk-count(bulk-count) 0 đã chọn
                    .bulk-spacer
                    form(
                        action=`${prefixAdmin}/products/change-multi?_method=PATCH`
                        method="POST"
                        form-change-multi
                        class="bulk-form"
                    ) 
                        select(name="type" class="form-control form-control-sm bulk-select" aria-label="Hành động hàng loạt")
                            option(value="active") Hoạt động
                            option(value="inactive") Dừng hoạt động
                            option(value="change-position") Thay đổi vị trí
                            option(value="deleteAll") Xóa tất cả 
                        input(
                            type="hidden"
                            name="ids"
                            value=""
                        )
                        button(type="submit" class="btn btn-primary btn-sm") Áp dụng

            else 

                .empty-state 
                    .empty-state-icon
                        i.fa-solid.fa-inbox
                    h3.empty-state-title Chưa có sản phẩm nào 
                    p.empty-state-desc Các sản phẩm thêm mới sẽ xuất hiện tại đây.
                    .empty-state-actions
                        if(role.permissions.includes("products_create"))
                            a(href=`${prefixAdmin}/products/create` class="btn btn-secondary") Thêm sản phẩm đầu tiên

        +pagination(objectPagination)

        form(
            form-change-status
            method='POST' 
            action="" 
            data-patch=prefixAdmin+`/products/change-status`)

        form(
            form-delete-button
            method='POST' 
            action="" 
            data-patch=prefixAdmin+`/products/delete`)
