extends ../../layouts/default.pug 

block main 
    -   const priceNew = Math.round(product.price - product.price * product.discountPercentage / 100);

    .page-header 
        .page-header-info 
            h1.page-header-title Chi tiết sản phẩm
            p.page-header-desc Xem trước thông tin hiển thị của sản phẩm
        .page-header-actions 
            a(href=`${prefixAdmin}/products` class="btn btn-ghost")
                i.fa-solid.fa-arrow-left
                | Danh sách

    .panel.profile-panel.detail-panel 
        .profile-head 
            img(
                class="profile-avatar"
                style="border-radius: 12px; width: 80px; height: 80px;"
                src=product.thumbnail
                alt=product.title
            )
            div 
                h2.profile-name #{product.title}
                div 
                    if (product.status)
                        if(product.status == "active")
                            span.status.status-ok Hoạt động
                        else 
                            span.status.status-off Ngừng hoạt động

        dl.detail-list 
            if (product.price)
                .profile-row 
                    dt Giá bán
                    dd #{new Intl.NumberFormat("vi-VN").format(priceNew)}₫

            if (product.discountPercentage)
                .profile-row 
                    dt Giảm giá
                    dd #{product.discountPercentage}%

            if (product.stock)
                .profile-row 
                    dt Còn lại
                    dd #{product.stock} sản phẩm

            if (product.position)
                .profile-row 
                    dt Vị trí
                    dd #{product.position}

        if (product.description)
            div(style="margin-top: 24px")
                p.form-section-title Mô tả sản phẩm
                .prose !{product.description}
