extends ../../layouts/default.pug 
include ../../mixins/alert.pug 

block main 

    if(role.permissions.includes("roles_view"))

        +alert-success()

        .page-header 
            .page-header-info 
                h1.page-header-title Phân quyền
                p.page-header-desc Thiết lập quyền hạn chi tiết cho từng nhóm quyền
            .page-header-actions 
                if(records)
                    button(
                        type="submit"
                        form="form-change-permissions"
                        class="btn btn-primary"
                        button-submit-permissions
                    ) Lưu phân quyền

        if(records)
            div(data-records=records)

            .panel 
                .table-responsive 
                    table(class="table" table-permissions)
                        thead   
                            tr 
                                th Tính năng 
                                each item in records   
                                    th(class="text-center") #{item.title}

                        tbody
                            tr(data-name="id" class="d-none")
                                td Id Nhóm quyền 
                                each item in records
                                    td(class="text-center")
                                        input(type="text" value=item.id)

                            tr.perm-group-row
                                td(colspan=(records.length + 1))
                                    | Danh mục sản phẩm 
                            tr(data-name="products-category_view")
                                td Xem
                                each item in records   
                                    td(class="text-center")
                                        input(type="checkbox" aria-label=("Danh mục - Xem - " + item.title))
                            tr(data-name="products-category_create")
                                td Thêm mới 
                                each item in records   
                                    td(class="text-center")
                                        input(type="checkbox" aria-label=("Danh mục - Thêm mới - " + item.title))
                            tr(data-name="products-category_edit")
                                td Chỉnh sửa 
                                each item in records   
                                    td(class="text-center")
                                        input(type="checkbox" aria-label=("Danh mục - Chỉnh sửa - " + item.title))
                            tr(data-name="products-category_delete")
                                td Xóa 
                                each item in records   
                                    td(class="text-center")
                                        input(type="checkbox" aria-label=("Danh mục - Xóa - " + item.title))

                            //- Sản phẩm
                            tr.perm-group-row
                                td(colspan=(records.length + 1))
                                    | Sản phẩm  
                            tr(data-name="products_view")
                                td Xem
                                each item in records   
                                    td(class="text-center")
                                        input(type="checkbox" aria-label=("Sản phẩm - Xem - " + item.title))
                            tr(data-name="products_create")
                                td Thêm mới 
                                each item in records   
                                    td(class="text-center")
                                        input(type="checkbox" aria-label=("Sản phẩm - Thêm mới - " + item.title))
                            tr(data-name="products_edit")
                                td Chỉnh sửa 
                                each item in records   
                                    td(class="text-center")
                                        input(type="checkbox" aria-label=("Sản phẩm - Chỉnh sửa - " + item.title))
                            tr(data-name="products_delete")
                                td Xóa 
                                each item in records   
                                    td(class="text-center")
                                        input(type="checkbox" aria-label=("Sản phẩm - Xóa - " + item.title))

                            //- Nhóm quyền
                            tr.perm-group-row
                                td(colspan=(records.length + 1))
                                    | Nhóm quyền 
                            tr(data-name="roles_view")
                                td Xem
                                each item in records   
                                    td(class="text-center")
                                        input(type="checkbox" aria-label=("Nhóm quyền - Xem - " + item.title))
                            tr(data-name="roles_create")
                                td Thêm mới 
                                each item in records   
                                    td(class="text-center")
                                        input(type="checkbox" aria-label=("Nhóm quyền - Thêm mới - " + item.title))
                            tr(data-name="roles_edit")
                                td Chỉnh sửa 
                                each item in records   
                                    td(class="text-center")
                                        input(type="checkbox" aria-label=("Nhóm quyền - Chỉnh sửa - " + item.title))
                            tr(data-name="roles_delete")
                                td Xóa 
                                each item in records   
                                    td(class="text-center")
                                        input(type="checkbox" aria-label=("Nhóm quyền - Xóa - " + item.title))
                            tr(data-name="roles_permissions")
                                td Phân quyền 
                                each item in records   
                                    td(class="text-center")
                                        input(type="checkbox" aria-label=("Nhóm quyền - Phân quyền - " + item.title))

                            //- Tài khoản
                            tr.perm-group-row
                                td(colspan=(records.length + 1))
                                    | Tài khoản 
                            tr(data-name="accounts_view")
                                td Xem
                                each item in records   
                                    td(class="text-center")
                                        input(type="checkbox" aria-label=("Tài khoản - Xem - " + item.title))
                            tr(data-name="accounts_create")
                                td Thêm mới 
                                each item in records   
                                    td(class="text-center")
                                        input(type="checkbox" aria-label=("Tài khoản - Thêm mới - " + item.title))
                            tr(data-name="accounts_edit")
                                td Chỉnh sửa 
                                each item in records   
                                    td(class="text-center")
                                        input(type="checkbox" aria-label=("Tài khoản - Chỉnh sửa - " + item.title))
                            tr(data-name="accounts_delete")
                                td Xóa 
                                each item in records   
                                    td(class="text-center")
                                        input(type="checkbox" aria-label=("Tài khoản - Xóa - " + item.title))

            form(
                id="form-change-permissions"
                form-change-permissions 
                method="POST"
                action=`${prefixAdmin}/roles/permissions?_method=PATCH`
            )
                input(
                    type="hidden"
                    name="roles"
                )
        else 
            .panel 
                .empty-state 
                    .empty-state-icon
                        i.fa-solid.fa-user-shield
                    h3.empty-state-title Chưa có nhóm quyền nào
                    p.empty-state-desc Cần tạo ít nhất một nhóm quyền trước khi phân quyền.
