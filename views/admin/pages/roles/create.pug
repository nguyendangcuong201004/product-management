extends ../../layouts/default.pug
include ../../mixins/alert.pug 

block main 
    .page-header 
        .page-header-info 
            h1.page-header-title Thêm mới nhóm quyền
            p.page-header-desc Định nghĩa một nhóm quyền mới cho hệ thống
        .page-header-actions 
            a(href=`${prefixAdmin}/roles` class="btn btn-ghost")
                i.fa-solid.fa-arrow-left
                | Danh sách

    +alert-error()

    form(
        action=`${prefixAdmin}/roles/create?_method=POST`
        method="POST"
    )
        .panel.form-panel 
            .form-section 
                .form-grid 
                    div 
                        label(for="title") Tiêu đề
                        input(
                            type="text"
                            class="form-control"
                            id="title"
                            name="title"
                            required
                        ) 
                    div 
                        label(for="desc") Mô tả
                        input(
                            type="text"
                            class="form-control"
                            name="description"
                            id="desc"
                        )

            .form-actions 
                button(type="submit" class="btn btn-primary") Tạo mới 
                a(href=`${prefixAdmin}/roles` class="btn btn-ghost") Hủy
