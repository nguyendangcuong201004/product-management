extends ../../layouts/default.pug
include ../../mixins/alert.pug 

block main 
    if(role.permissions.includes("roles_view"))

        .page-header 
            .page-header-info 
                h1.page-header-title Nhóm quyền
                p.page-header-desc Phân nhóm quyền hạn cho tài khoản quản trị
            .page-header-actions 
                if(role.permissions.includes("roles_create"))
                    a(
                        href=`${prefixAdmin}/roles/create`
                        class="btn btn-primary"
                    )
                        i.fa-solid.fa-plus
                        | Thêm mới

        +alert-success()

        if(records.length > 0)
            .panel
                .table-responsive
                    table(class="table")
                        thead
                            tr
                                th STT
                                th Nhóm quyền
                                th Mô tả
                                th.text-right Hành động
                        tbody
                            each item, index in records
                                tr
                                    td.cell-muted.tnum #{index + 1}
                                    td 
                                        .cell-strong #{item.title}
                                    td #{item.description}
                                    td
                                        .row-actions
                                            if(role.permissions.includes("roles_edit"))
                                                a(
                                                    class="icon-btn icon-btn-sm"
                                                    href=`${prefixAdmin}/roles/edit/${item.id}`
                                                    title="Sửa"
                                                    aria-label="Sửa"
                                                )
                                                    i.fa-regular.fa-pen-to-square
        else
            .panel 
                .empty-state 
                    .empty-state-icon
                        i.fa-solid.fa-user-shield
                    h3.empty-state-title Chưa có nhóm quyền nào được tạo
                    p.empty-state-desc Tạo nhóm quyền để phân quyền cho các tài khoản quản trị.
                    .empty-state-actions
                        if(role.permissions.includes("roles_create"))
                            a(href=`${prefixAdmin}/roles/create` class="btn btn-secondary") Thêm nhóm quyền
