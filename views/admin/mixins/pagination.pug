mixin pagination(objectPagination)
    .pagination-wrap
        ul(class="pagination")
            li(class=`page-item ${objectPagination.currentPage > 1 ? "" : "disabled"}`)
                if (objectPagination.currentPage > 1)
                    button(class="page-link" type="button" button-pagination=objectPagination.currentPage-1 aria-label="Trang trước")
                        i.fa-solid.fa-chevron-left
                else
                    span(class="page-link disabled" aria-hidden="true")
                        i.fa-solid.fa-chevron-left
            -   for (var i = 1; i <= objectPagination.totalPage; i++)
                if (i == objectPagination.currentPage)
                    li(class="page-item active")
                        button(class="page-link" type="button" button-pagination=i) #{i}
                else 
                    li(class="page-item")
                        button(class="page-link" type="button" button-pagination=i) #{i}
            li(class=`page-item ${objectPagination.currentPage < objectPagination.totalPage ? "" : "disabled"}`)
                if (objectPagination.currentPage < objectPagination.totalPage)
                    button(class="page-link" type="button" button-pagination=+objectPagination.currentPage+1 aria-label="Trang sau")
                        i.fa-solid.fa-chevron-right
                else
                    span(class="page-link disabled" aria-hidden="true")
                        i.fa-solid.fa-chevron-right
