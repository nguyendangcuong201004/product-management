mixin show-recursion(records, level = 1)
    each item, index in records
        -   const prefix = Array(level + 1).join("-- ");
        tr
            td.checkbox-col
                input(type="checkbox" name="id" value=item.id aria-label=("Chọn " + item.title))
            td.cell-muted.tnum #{index + 1}
            td
                img(
                    class="table-thumb"
                    src=item.thumbnail
                    alt=item.title
                    loading="lazy"
                )
            td
                span.cell-strong #{prefix}#{item.title}
            td 
                input(
                    value=item.position
                    type="number"
                    min="1"
                    name="position"
                    class="form-control input-position"
                    aria-label="Vị trí"
                )
            td
                if (item.status == "active")
                    a(href="javascript:;" class="status status-ok" button-change-status="" data-id=item.id data-status="inactive") Hoạt động
                else 
                    a(href="javascript:;" class="status status-off" button-change-status="" data-id=item.id data-status="active") Ngừng hoạt động
            td
                .row-actions
                    if(role.permissions.includes("products-category_edit"))
                        a(
                            class="icon-btn icon-btn-sm"
                            href=`${prefixAdmin}/products-category/edit/${item.id}`
                            title="Sửa"
                            aria-label="Sửa"
                        )
                            i.fa-regular.fa-pen-to-square
                    if(role.permissions.includes("products-category_delete"))
                        button(
                            type="button"
                            class="icon-btn icon-btn-sm icon-danger"
                            button-delete=""
                            data-id=item.id
                            title="Xóa"
                            aria-label="Xóa"
                        )
                            i.fa-regular.fa-trash-can
        if(item.children && item.children.length > 0)
            +show-recursion(item.children, level + 1)
