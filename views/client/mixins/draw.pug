mixin draw(products)
    .row 
        each item in products
            .col-6.col-md-4.mb-4 
                .product-item   
                    .inner-image 
                        a(href=`/products/detail/${item.slug}`)
                            img(src=item.thumbnail alt=item.title loading="lazy")
                    .inner-content 
                        h3.inner-title
                            a(href=`/products/detail/${item.slug}`) #{item.title}
                        .inner-price-new #{new Intl.NumberFormat("vi-VN").format(Math.round(item.price - item.price * item.discountPercentage / 100))}₫
                        if(item.discountPercentage > 0)
                            .inner-price-old #{new Intl.NumberFormat("vi-VN").format(item.price)}₫
                            .inner-discount -#{item.discountPercentage}%
