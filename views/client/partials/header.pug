include ../mixins/sub-menu.pug

header.site-header
    .container
        .header-inner
            a.brand(href="/")
                img(src=settingGeneral.logo alt=(settingGeneral.websiteName || "Logo"))

            .header-search
                form(
                    action=`/search`
                    method="GET"
                    class="search-field"
                )
                    i(class="fa-solid fa-magnifying-glass search-icon")
                    input(
                        type="text"
                        placeholder="Bạn cần tìm kiếm gì?"
                        class="form-control"
                        name="keyword"
                        value=keyword
                    )

            nav.main-nav(aria-label="Điều hướng chính")
                ul.main-nav-list
                    li
                        a(href="/" class="nav-link-c") Trang chủ
                    li(class="sub-menu")
                        a(href="/products" class="nav-link-c") Sản phẩm
                        +sub-menu(layoutProductCatetory)

            .header-actions
                a.icon-btn(href="/cart" aria-label="Giỏ hàng")
                    i.fa-solid.fa-cart-shopping
                    if (miniCart && miniCart.products.length > 0)
                        span.cart-count #{miniCart.products.length}

                if (user)
                    a.account-chip(href="/user/info" title="Thông tin cá nhân")
                        | #{user.fullName}
                    a.icon-btn(
                        href="/user/logout"
                        title="Đăng xuất"
                        aria-label="Đăng xuất"
                    )
                        i.fa-solid.fa-arrow-right-from-bracket
                else
                    a(href="/user/login" class="btn btn-ghost btn-sm") Đăng nhập
                    a(href="/user/register" class="btn btn-primary btn-sm") Đăng ký

if (user)
    a(href="/users/friends" class="chat-realtime")
        i.fa-regular.fa-comments
        | Bạn bè
