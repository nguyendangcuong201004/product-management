extends ../../layouts/default.pug
include ../../mixins/box-head.pug 

block main 

    .container.my-5

        include ../../partials/list-btn-user.pug

        .section-head(style="margin-top: 24px")
            div 
                h2.section-title Lời mời kết bạn

        .row(data-users-accept=user.id)    
            each user in users
                .col-6(user-id=user.id) 
                    div(class="box-user")
                        div(class="inner-avatar")
                            img(src="https://i.imgur.com/ttyjQxs.jpeg", alt="avatat")
                        div(class="inner-info")
                            div(class="inner-name") #{user.fullName}
                            div(class="inner-buttons")
                                button(
                                    class="btn btn-sm btn-primary mr-1"
                                    btn-accept-friend=user.id
                                ) Chấp nhận
                                button(
                                    class="btn btn-sm btn-secondary mr-1"
                                    btn-refuse-friend=user.id
                                ) Xóa  
                                button(
                                    class="btn btn-sm btn-secondary mr-1"
                                    btn-delete-friend=user.id
                                ) Đã xóa
                                button(
                                    class="btn btn-sm btn-primary mr-1"
                                    btn-accepted-friend=user.id
                                ) Bạn bè
