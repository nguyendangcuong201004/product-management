extends ../../layouts/default.pug  
include ../../mixins/box-head.pug

block main 
    .container.my-5 
        include ../../partials/list-btn-user.pug

        .auth-page(style="padding: 24px 0 0")
            .panel.form-panel(style="max-width: 520px; padding: 28px; margin-top: 0") 
                h2.section-title(style="margin-bottom: 20px") Tạo phòng chat

                form(
                    action="/rooms-chat/create"
                    method="POST"
                )
                    div(class="form-group")
                        label(for="title") Tên phòng chat
                        input(
                            type="text"
                            class="form-control"
                            id="title"
                            name="title"
                            required
                            placeholder="VD: Nhóm đi chơi cuối tuần"
                        )

                    div(class="form-group")
                        label Thêm thành viên
                        if (friendsList.length > 0)
                            div(style="max-height: 220px; overflow-y: auto; border: 1px solid var(--line); border-radius: 8px; padding: 12px 14px; margin-top: 6px")
                                each friend in friendsList
                                    div(class="form-check")
                                        input(
                                            type="checkbox"
                                            class="form-check-input"
                                            value=friend.user_id
                                            id=`user-${friend.user_id}`
                                            name="usersId"
                                        )
                                        label(
                                            class="form-check-label"
                                            for=friend.user_id
                                        ) #{friend.infoFriend.fullName}
                        else 
                            p.form-hint Bạn chưa có bạn bè nào để thêm vào phòng.

                    button(
                        class="btn btn-primary mt-2"
                        type="submit"
                    ) Tạo phòng
