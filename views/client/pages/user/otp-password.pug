extends ../../layouts/default.pug 
include ../../mixins/alert.pug

block main 
    +alert-success()
    +alert-error()

    .auth-page 
        .auth-card 
            h1.auth-title Nhập mã xác thực
            p.auth-subtitle Mã OTP đã được gửi đến email của bạn

            form(
                action=`/user/password/otp`
                method="POST"
            )
                div(class="form-group")
                    label(for="email") Email
                    input(
                        type="email"
                        class="form-control"
                        id="email"
                        name="email"
                        value=email
                        readonly
                    )

                div(class="form-group")
                    label(for="otp") Mã OTP
                    input(
                        type="text"
                        class="form-control"
                        id="otp"
                        name="otp"
                        required
                    )

                button(type="submit" class="btn btn-primary btn-block") Xác nhận
