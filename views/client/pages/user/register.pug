extends ../../layouts/default.pug 
include ../../mixins/alert.pug

block main 
    +alert-success()
    +alert-error()

    .auth-page 
        .auth-card 
            h1.auth-title Đăng ký tài khoản
            p.auth-subtitle Tạo tài khoản để trải nghiệm mua sắm tốt hơn

            form(
                action=`/user/register`
                method="POST"
            )
                div(class="form-group")
                    label(for="fullName") Họ và tên
                    input(
                        type="text"
                        class="form-control"
                        id="fullName"
                        name="fullName"
                        required
                    )

                div(class="form-group")
                    label(for="email") Email
                    input(
                        type="email"
                        class="form-control"
                        id="email"
                        name="email"
                        required
                    )

                div(class="form-group")
                    label(for="password") Mật khẩu
                    input(
                        type="password"
                        class="form-control"
                        id="password"
                        name="password"
                        required
                    )

                button(type="submit" class="btn btn-primary btn-block") Đăng ký

            p.auth-footer 
                | Đã có tài khoản?
                a(href="/user/login")  Đăng nhập
