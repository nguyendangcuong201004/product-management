extends ../../layouts/default.pug 
include ../../mixins/alert.pug

block main 
    +alert-success()
    +alert-error()

    .auth-page 
        .auth-card 
            h1.auth-title Đặt lại mật khẩu
            p.auth-subtitle Tạo mật khẩu mới cho tài khoản của bạn

            form(
                action=`/user/password/reset`
                method="POST"
            )
                div(class="form-group")
                    label(for="password") Mật khẩu mới 
                    input(
                        type="password"
                        class="form-control"
                        id="password"
                        name="password"
                        required
                    )

                div(class="form-group")
                    label(for="confirmPassword") Xác nhận mật khẩu
                    input(
                        type="password"
                        class="form-control"
                        id="confirmPassword"
                        name="confirmPassword"
                        required
                    )

                button(type="submit" class="btn btn-primary btn-block") Xác nhận
