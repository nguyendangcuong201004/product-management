extends ../../layouts/default.pug 
include ../../mixins/alert.pug

block main 
    +alert-success()
    +alert-error()

    .container.my-5 
        .auth-page(style="padding: 0")
            .panel.profile-panel(style="max-width: 560px; margin-top: 0") 
                .profile-head 
                    img(
                        class="profile-avatar"
                        src=user.avatar ? user.avatar : "/admin/images/avatar.png"
                        alt=user.fullName
                    )
                    div 
                        h2.profile-name #{user.fullName}
                        span.tag Khách hàng

                dl.detail-list
                    if(user.fullName)
                        .profile-row 
                            dt Họ và tên
                            dd #{user.fullName}
                    if(user.email)
                        .profile-row 
                            dt Email
                            dd #{user.email}
