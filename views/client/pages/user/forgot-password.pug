extends ../../layouts/default.pug 
include ../../mixins/alert.pug

block main 
    +alert-success()
    +alert-error()

    .auth-page 
        .auth-card 
            h1.auth-title Lấy lại mật khẩu
            p.auth-subtitle Nhập email đã đăng ký để nhận mã xác thực

            form(
                action=`/user/password/forgot`
                method="POST"
            )
                div(class="form-group")
                    label(for="email") Email
                    input(
                        type="email"
                        class="form-control"
                        id="email"
                        name="email"
                        required
                    )

                button(type="submit" class="btn btn-primary btn-block") Gửi mã xác thực

            p.auth-footer 
                a(href="/user/login") Quay lại đăng nhập
