extends ../../layouts/default.pug 
include ../../mixins/alert.pug

block main 
    +alert-success()
    +alert-error()

    .container.my-5 
        .section-head 
            div 
                p.section-overline Giỏ hàng
                h2.section-title Giỏ hàng của bạn
            if (cartDetail.products.length > 0)
                span.section-link.cell-muted #{cartDetail.products.length} sản phẩm

        if (cartDetail.products.length > 0)
            .panel 
                .table-responsive 
                    table(class="table table-hover" table-cart)
                        thead
                            tr  
                                th STT 
                                th Ảnh 
                                th Sản phẩm 
                                th.text-right Giá
                                th Số lượng
                                th.text-right Thành tiền
                                th
                        tbody 
                            each item, index in cartDetail.products
                                tr 
                                    td.cell-muted.tnum #{index + 1}
                                    td
                                        img(
                                            class="table-thumb"
                                            src=item.infoProduct.thumbnail
                                            alt=item.infoProduct.title
                                            loading="lazy"
                                        )
                                    td 
                                        a(href=`/products/detail/${item.infoProduct.slug}` class="cell-strong") #{item.infoProduct.title}
                                    td.cell-num #{new Intl.NumberFormat("vi-VN").format(Math.round(item.infoProduct.price - item.infoProduct.price * item.infoProduct.discountPercentage / 100))}₫
                                    td 
                                        input(
                                            type="number"
                                            name="quantity"
                                            value=item.quantity
                                            min="1"
                                            max=item.infoProduct.stock
                                            item-id=item.product_id
                                            class="form-control input-position"
                                            style="width: 72px"
                                            aria-label="Số lượng"
                                        )
                                    td.cell-num.cell-strong #{new Intl.NumberFormat("vi-VN").format(item.quantity * Math.round(item.infoProduct.price - item.infoProduct.price * item.infoProduct.discountPercentage / 100))}₫
                                    td 
                                        .row-actions
                                            a(href=`/cart/delete/${item.product_id}` class="icon-btn icon-btn-sm icon-danger" title="Xóa" aria-label="Xóa")
                                                i.fa-regular.fa-trash-can

            .cart-summary 
                div(style="text-align: right")
                    p.cart-total-label Tổng đơn hàng
                    p.cart-total-value #{new Intl.NumberFormat("vi-VN").format(cartDetail.totalPrice)}₫
                a(href="/checkout" class="btn btn-primary btn-lg")
                    | Thanh toán
                    i.fa-solid.fa-arrow-right
        else 
            .panel 
                .empty-state 
                    .empty-state-icon
                        i.fa-solid.fa-cart-shopping
                    h3.empty-state-title Giỏ hàng trống
                    p.empty-state-desc Bạn chưa thêm sản phẩm nào vào giỏ hàng.
                    .empty-state-actions
                        a(href="/products" class="btn btn-primary") Mua sắm ngay
