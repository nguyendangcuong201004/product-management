extends ../../layouts/default.pug
include ../../mixins/draw.pug

block main 
    .container.my-5
        .section-head 
            div 
                p.section-overline Kết quả tìm kiếm
                h2.section-title “#{keyword}”
            span.section-link.cell-muted #{products.length} kết quả

        if (products.length > 0)
            +draw(products)
        else 
            .empty-state 
                .empty-state-icon
                    i.fa-solid.fa-magnifying-glass
                h3.empty-state-title Không tìm thấy sản phẩm phù hợp
                p.empty-state-desc Hãy thử với từ khóa khác hoặc xem toàn bộ sản phẩm.
                .empty-state-actions
                    a(href="/products" class="btn btn-secondary") Xem tất cả sản phẩm
