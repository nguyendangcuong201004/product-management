extends ../../layouts/default.pug
include ../../mixins/draw.pug

block main
    .container.mt-5 
        section.section 
            .section-head 
                div 
                    p.section-overline Nổi bật
                    h2.section-title Sản phẩm nổi bật
                a.section-link(href="/products") Xem tất cả
            +draw(productFeatured)

        section.section 
            .section-head 
                div 
                    p.section-overline Mới lên kệ
                    h2.section-title Sản phẩm mới nhất
                a.section-link(href="/products") Xem tất cả
            +draw(productNew)
