extends ../../layouts/default.pug
include ../../mixins/draw.pug
include ../../mixins/box-head.pug

block main 
    .container.my-5 
        .section-head 
            div 
                p.section-overline Cửa hàng
                h2.section-title Tất cả sản phẩm
            span.section-link.cell-muted #{products.length} sản phẩm

        if (products.length > 0)
            +draw(products)
        else 
            .empty-state 
                .empty-state-icon
                    i.fa-solid.fa-box-open
                h3.empty-state-title Chưa có sản phẩm nào
                p.empty-state-desc Các sản phẩm sẽ xuất hiện tại đây khi được đăng bán.
