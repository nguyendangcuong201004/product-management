extends ../../layouts/default.pug 
include ../../mixins/alert.pug

block main 

    +alert-error()
    +alert-success()

    .product-detail
        .container.my-5
            .row
                .col-lg-6.mb-4.mb-lg-0
                    .inner-thumb
                        img(src=product.thumbnail, alt=product.title)
                .col-lg-6
                    if (product.category)
                        div(class="inner-category")
                            | Danh mục:
                            a(href=`/products/${product.category.slug}`)  #{product.category.title}

                    h1(class="inner-title") #{product.title}

                    if (product.price)
                        div(class="inner-price-new") #{new Intl.NumberFormat("vi-VN").format(Math.round(product.price - product.price * product.discountPercentage / 100))}₫

                    if (product.price)
                        div(class="inner-price-old") #{new Intl.NumberFormat("vi-VN").format(product.price)}₫

                    if (product.discountPercentage)
                        div(class="inner-percent") Giảm tới <span>#{product.discountPercentage}%</span>

                    if (product.stock)
                        div(class="inner-stock") Còn lại <span>#{product.stock}</span> sản phẩm

                    form(
                        action=`/cart/add/${product.id}`
                        method="POST"
                        class="cart-add-form"
                    )
                        input(
                        class="form-control"
                        type="number"
                        name="quantity"
                        value="1"
                        min="1"
                        max=product.stock
                        aria-label="Số lượng"
                        )
                        button(
                        type="submit"
                        class="btn btn-primary btn-lg"
                        ) Thêm vào giỏ hàng

            hr

            section.section 
                .section-head 
                    div 
                        h2.section-title Mô tả sản phẩm
                .inner-desc.prose !{product.description}
